; Engine configuration file.
; OXENWAR - Godot game
config_version=5

[application]
config/name="OxenWar"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="OxenWar: free-to-play cross-platform parkour arena with accounts, friends and free character cosmetics."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true
window/frame_pacing/android/enable_frame_pacing=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.015, 0.025, 0.055, 1)

[physics]
3d/default_gravity=18.0

