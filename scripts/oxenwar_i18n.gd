static func text_for(key: String, locale: String) -> String:
	var language: Dictionary = TEXTS.get(locale, TEXTS["en"])
	if language.has(key):
		return str(language[key])
	var extra: Dictionary = EXTRA.get(locale, EXTRA["en"])
	if extra.has(key):
		return str(extra[key])
	if TEXTS["en"].has(key):
		return str(TEXTS["en"][key])
	return str(EXTRA["en"].get(key, key))
